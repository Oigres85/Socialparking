rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidLat(lat) {
      return lat is number && lat >= -90 && lat <= 90;
    }

    function isValidLon(lon) {
      return lon is number && lon >= -180 && lon <= 180;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Campi che il client può scrivere sul proprio profilo.
    // Punti, badge, streak e statistiche sono scritti SOLO dalle Cloud Functions (anti-cheat).
    function clientUserKeys() {
      return ['latitude', 'longitude', 'lastLocationUpdate', 'isSearching', 'pushSubscription',
              'fcmToken', 'platform', 'lang', 'referralCode', 'createdAt'];
    }

    function isValidReferralCode(code) {
      return code is string && code.matches('^[2-9A-HJ-NP-Z]{6}$');
    }

    // --- USERS ---
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(clientUserKeys());
      allow update: if isOwner(userId) && changedKeys().hasOnly(clientUserKeys());
      allow delete: if isOwner(userId);
    }

    // --- REFERRALS: codice invito -> uid ---
    match /referrals/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn()
                    && isValidReferralCode(code)
                    && request.resource.data.keys().hasOnly(['uid'])
                    && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // --- REFERRAL CLAIMS: "sono stato invitato da <code>" (una sola volta, elaborato dalla Cloud Function) ---
    match /referralClaims/{userId} {
      allow read, update, delete: if false;
      allow create: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['code'])
                    && isValidReferralCode(request.resource.data.code);
    }

    // --- PARKINGS ---
    match /parkings/{parkingId} {
      allow get, list: if isSignedIn();

      allow create: if isSignedIn()
                    && request.resource.data.keys().hasOnly(['latitude', 'longitude', 'status', 'timestamp', 'userId'])
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.status == 'libero'
                    && request.resource.data.timestamp == request.time
                    && isValidLat(request.resource.data.latitude)
                    && isValidLon(request.resource.data.longitude);

      allow update: if isSignedIn() && changedKeys().hasOnly(['status', 'reservedById', 'bookingCode']) && (
                      (
                        // Prenotazione: posto libero, non scaduto, non proprio
                        resource.data.status == 'libero'
                        && resource.data.userId != request.auth.uid
                        && resource.data.timestamp > request.time - duration.value(3, 'm')
                        && request.resource.data.status == 'in arrivo'
                        && request.resource.data.reservedById == request.auth.uid
                        && request.resource.data.bookingCode is string
                        && request.resource.data.bookingCode.size() == 4
                      ) || (
                        // Annullamento da parte di chi ha prenotato
                        resource.data.status == 'in arrivo'
                        && resource.data.reservedById == request.auth.uid
                        && request.resource.data.status == 'libero'
                        && request.resource.data.reservedById == null
                      )
                    );

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // --- STATS: contatori pubblici aggregati, scritti solo dalle Cloud Functions ---
    match /stats/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
